# ForgeLab Environment Configuration
# Copy this file to .env and fill in your values.

# Database
FORGELAB_DATABASE_URL=sqlite:///./forgelab.db

# Agent Provider (mock, openai, anthropic, etc.)
FORGELAB_PROVIDER=mock

# API Configuration (for real LLM agents)
FORGELAB_API_KEY=
FORGELAB_BASE_URL=
FORGELAB_MODEL=

# Agent Settings
FORGELAB_MAX_STEPS=50

# Sandbox
FORGELAB_SANDBOX_IMAGE=forgelab/sandbox:python3.11

# Logging
FORGELAB_LOG_LEVEL=INFO
