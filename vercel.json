{
  "version": 2,
  "name": "forgelab",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/api/v1/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/" }
  ],
  "env": {
    "FORGELAB_DATABASE_URL": "sqlite:///tmp/forgelab.db",
    "FORGELAB_ENV": "vercel"
  }
}
