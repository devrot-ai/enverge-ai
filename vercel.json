{
  "version": 2,
  "name": "forgelab",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "headers": { "cache-control": "s-maxage=31536000, immutable" }, "dest": "/public/$1" }
  ],
  "env": {
    "FORGELAB_DATABASE_URL": "sqlite:///tmp/forgelab.db",
    "FORGELAB_ENV": "vercel"
  }
}
